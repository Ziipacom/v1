{
  "rules": [
    {
      "allowed": {
        "origins": [
          "https://ziipa.com",
          "https://www.ziipa.com",
          "https://app.ziipa.com",
          "http://localhost:5178",
          "http://localhost:8082"
        ],
        "methods": ["PUT"],
        "headers": ["Content-Type"]
      },
      "exposeHeaders": ["ETag"],
      "maxAgeSeconds": 3600
    },
    {
      "allowed": {
        "origins": [
          "https://ziipa.com",
          "https://www.ziipa.com",
          "https://app.ziipa.com"
        ],
        "methods": ["GET", "HEAD"],
        "headers": ["Range", "If-Range"]
      },
      "exposeHeaders": ["Content-Range", "Accept-Ranges", "Content-Length", "ETag"],
      "maxAgeSeconds": 3600
    }
  ]
}
