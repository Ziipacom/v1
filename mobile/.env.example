# Android emulator. For a device use your computer's LAN address; see README.
EXPO_PUBLIC_API_URL=http://10.0.2.2:8018
# Store builds use https://api.ziipa.com (configured in eas.json).
APP_VARIANT=preview
EXPO_PUBLIC_ENABLE_DEMO=true
EXPO_PUBLIC_ENABLE_CONCEPTS=true

# Add verified HTTPS URLs only after these documents/pages are deployed.
EXPO_PUBLIC_PRIVACY_URL=
EXPO_PUBLIC_TERMS_URL=
EXPO_PUBLIC_COMMUNITY_URL=
EXPO_PUBLIC_DELETE_ACCOUNT_URL=
EXPO_PUBLIC_SUPPORT_EMAIL=hello@ziipa.com

# Non-secret identity values. Confirm the app ID before first submission.
ZIIPA_APP_ID=com.ziipa.app
ZIIPA_APP_ID_CONFIRMED=false
EXPO_OWNER=
EXPO_EAS_PROJECT_ID=
ZIIPA_SIGNING_REVIEWED=false

# Owner export-compliance decision, including bundled crypto/WebRTC dependencies.
# Leave unset until reviewed; do not assume that HTTPS alone determines the answer.
ZIIPA_ENCRYPTION_REVIEWED=false
ZIIPA_USES_NON_EXEMPT_ENCRYPTION=
# If Apple supplies a compliance code after review, enter that exact value.
ZIIPA_APPLE_ENCRYPTION_COMPLIANCE_CODE=

# Set true only after the release checklist in store/RELEASE.md is completed.
ZIIPA_RELEASE_REVIEWED=false

# Public connector identity; no seed phrases, private keys, or pinning API keys.
EXPO_PUBLIC_WALLETCONNECT_PROJECT_ID=
EXPO_PUBLIC_WALLET_ORIGIN=http://localhost:8082
# Set only after the Web3/device/store/security checklist in ../WEB3.md.
ZIIPA_WEB3_REVIEWED=false
