{
  "cli": { "version": ">= 18.0.0", "appVersionSource": "remote" },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "environment": "development",
      "env": {
        "EXPO_OWNER": "ziipa",
        "EXPO_EAS_PROJECT_ID": "a130b762-6812-4963-9ebd-5d103a24084e",
        "APP_VARIANT": "preview",
        "EXPO_PUBLIC_API_URL": "https://api.ziipa.com",
        "EXPO_PUBLIC_ENABLE_DEMO": "true",
        "EXPO_PUBLIC_ENABLE_CONCEPTS": "true"
      }
    },
    "preview": {
      "distribution": "internal",
      "environment": "preview",
      "android": { "buildType": "apk" },
      "env": {
        "EXPO_OWNER": "ziipa",
        "EXPO_EAS_PROJECT_ID": "a130b762-6812-4963-9ebd-5d103a24084e",
        "APP_VARIANT": "preview",
        "EXPO_PUBLIC_API_URL": "https://api.ziipa.com",
        "EXPO_PUBLIC_ENABLE_DEMO": "true",
        "EXPO_PUBLIC_ENABLE_CONCEPTS": "true"
      }
    },
    "android-universal-apk": {
      "extends": "preview",
      "android": {
        "buildType": "apk",
        "withoutCredentials": true,
        "autoIncrement": false,
        "env": {
          "ORG_GRADLE_PROJECT_reactNativeArchitectures": "armeabi-v7a,arm64-v8a,x86,x86_64"
        }
      },
      "env": { "EXPO_NO_DOTENV": "1" }
    },
    "ios-internal-testflight": {
      "extends": "production",
      "distribution": "store",
      "credentialsSource": "remote",
      "environment": "preview",
      "env": {
        "EXPO_NO_DOTENV": "1",
        "ZIIPA_BUILD_SCOPE": "ios-internal-testflight",
        "EXPO_PUBLIC_BUILD_SCOPE": "ios-internal-testflight",
        "ZIIPA_APP_ID": "com.ziipa.app",
        "ZIIPA_APPLE_TEAM_ID": "L6WH6BD2N5",
        "ZIIPA_ASC_APP_ID": "6827668999",
        "ZIIPA_TESTFLIGHT_DISTRIBUTION": "internal-only",
        "ZIIPA_TESTFLIGHT_DEVICE_QA": "pending",
        "ZIIPA_TESTFLIGHT_EXPORT_COMPLIANCE": "pending-owner-final-binary-review",
        "ZIIPA_TESTFLIGHT_PUBLIC_RELEASE": "forbidden"
      }
    },
    "ios-external-testflight": {
      "extends": "production",
      "distribution": "store",
      "credentialsSource": "remote",
      "environment": "preview",
      "env": {
        "EXPO_NO_DOTENV": "1",
        "ZIIPA_BUILD_SCOPE": "ios-external-testflight",
        "EXPO_PUBLIC_BUILD_SCOPE": "ios-external-testflight",
        "ZIIPA_APP_ID": "com.ziipa.app",
        "ZIIPA_APPLE_TEAM_ID": "L6WH6BD2N5",
        "ZIIPA_ASC_APP_ID": "6827668999",
        "EXPO_PUBLIC_PRIVACY_URL": "https://ziipa.com/privacy-beta",
        "EXPO_PUBLIC_SUPPORT_EMAIL": "ziipaziipa@gmail.com",
        "ZIIPA_TESTFLIGHT_DISTRIBUTION": "limited-external-preparation",
        "ZIIPA_TESTFLIGHT_DEVICE_QA": "pending",
        "ZIIPA_TESTFLIGHT_EXPORT_COMPLIANCE": "pending-owner-final-binary-review",
        "ZIIPA_TESTFLIGHT_POLICY_STATUS": "pending-owner-review-and-publication",
        "ZIIPA_TESTFLIGHT_REVIEWER_STATUS": "pending-owner-setup",
        "ZIIPA_TESTFLIGHT_APPLE_BETA_REVIEW": "pending",
        "ZIIPA_TESTFLIGHT_EXTERNAL_DISTRIBUTION": "blocked-until-owner-checks-and-apple-approval",
        "ZIIPA_TESTFLIGHT_PUBLIC_RELEASE": "forbidden"
      }
    },
    "production": {
      "distribution": "store",
      "credentialsSource": "remote",
      "environment": "production",
      "autoIncrement": true,
      "android": { "buildType": "app-bundle" },
      "env": {
        "EXPO_OWNER": "ziipa",
        "EXPO_EAS_PROJECT_ID": "a130b762-6812-4963-9ebd-5d103a24084e",
        "APP_VARIANT": "production",
        "EXPO_PUBLIC_PORTAL_MODE": "false",
        "EXPO_PUBLIC_API_URL": "https://api.ziipa.com",
        "EXPO_PUBLIC_ENABLE_DEMO": "false",
        "EXPO_PUBLIC_ENABLE_CONCEPTS": "false"
      }
    }
  },
  "submit": {
    "ios-external-testflight": {
      "ios": { "ascAppId": "6827668999", "appleTeamId": "L6WH6BD2N5" }
    },
    "ios-internal-testflight": {
      "ios": { "ascAppId": "6827668999", "appleTeamId": "L6WH6BD2N5" }
    },
    "production": {
      "ios": { "ascAppId": "6827668999" },
      "android": { "track": "internal", "releaseStatus": "draft" }
    }
  }
}
