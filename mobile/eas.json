{
  "cli": { "version": ">= 18.0.0", "appVersionSource": "remote" },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "environment": "development",
      "env": {
        "EXPO_OWNER": "ziipa",
        "EXPO_EAS_PROJECT_ID": "a130b762-6812-4963-9ebd-5d103a24084e",
        "APP_VARIANT": "preview",
        "EXPO_PUBLIC_API_URL": "https://api.ziipa.com",
        "EXPO_PUBLIC_ENABLE_DEMO": "true",
        "EXPO_PUBLIC_ENABLE_CONCEPTS": "true"
      }
    },
    "preview": {
      "distribution": "internal",
      "environment": "preview",
      "android": { "buildType": "apk" },
      "env": {
        "EXPO_OWNER": "ziipa",
        "EXPO_EAS_PROJECT_ID": "a130b762-6812-4963-9ebd-5d103a24084e",
        "APP_VARIANT": "preview",
        "EXPO_PUBLIC_API_URL": "https://api.ziipa.com",
        "EXPO_PUBLIC_ENABLE_DEMO": "true",
        "EXPO_PUBLIC_ENABLE_CONCEPTS": "true"
      }
    },
    "production": {
      "distribution": "store",
      "credentialsSource": "remote",
      "environment": "production",
      "autoIncrement": true,
      "android": { "buildType": "app-bundle" },
      "env": {
        "EXPO_OWNER": "ziipa",
        "EXPO_EAS_PROJECT_ID": "a130b762-6812-4963-9ebd-5d103a24084e",
        "APP_VARIANT": "production",
        "EXPO_PUBLIC_PORTAL_MODE": "false",
        "EXPO_PUBLIC_API_URL": "https://api.ziipa.com",
        "EXPO_PUBLIC_ENABLE_DEMO": "false",
        "EXPO_PUBLIC_ENABLE_CONCEPTS": "false"
      }
    }
  },
  "submit": {
    "production": {
      "ios": {},
      "android": { "track": "internal", "releaseStatus": "draft" }
    }
  }
}
