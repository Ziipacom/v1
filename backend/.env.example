DATABASE_URL=postgresql+psycopg://ziipa:ziipa_local@127.0.0.1:55439/ziipa
REDIS_URL=redis://127.0.0.1:56389/0
FRONTEND_ORIGIN=http://localhost:5178
MOBILE_WEB_ORIGIN=http://localhost:8082
UPLOADS_DIR=uploads
SECURE_COOKIES=false
MODERATOR_EMAILS=
ENABLE_DEMO_CATALOG=true
ENVIRONMENT=development
RELEASE=local
API_PUBLIC_ORIGIN=http://localhost:8018
PUBLIC_APP_URL=http://localhost:5178

# Production account email. Registration remains usable in local demo mode when unset.
REQUIRE_EMAIL_VERIFICATION=false
RESEND_API_KEY=
EMAIL_FROM=Ziipa <accounts@ziipa.com>
SENTRY_DSN=

# Private creator media. Use local in development and r2 in hosted environments.
MEDIA_STORAGE_BACKEND=local
# Database-ledger quotas shared by API and render worker (not a provider billing meter).
MEDIA_OWNER_MAX_BYTES=1073741824
# 0 disables the project cap; strict-free profile uses 6442450944 (6 GiB).
MEDIA_PROJECT_MAX_BYTES=0
R2_ENDPOINT_URL=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=ziipa-media
R2_PRESIGN_TTL_SECONDS=900
R2_DOWNLOAD_TTL_SECONDS=300

# Public client identifiers only. Provider secrets belong in a secret manager.
# Account OAuth callbacks and provider review are required before direct posting.
SOCIAL_BLUESKY_CLIENT_ID=
SOCIAL_FACEBOOK_CLIENT_ID=
SOCIAL_INSTAGRAM_CLIENT_ID=
SOCIAL_TIKTOK_CLIENT_ID=
SOCIAL_TWITCH_CLIENT_ID=
SOCIAL_YOUTUBE_CLIENT_ID=
# Public read-only Bluesky imports. No social password, token, or secret is collected.
# Setting a client ID alone DOES NOT enable OAuth or automatic cross-posting.
SOCIAL_PUBLIC_SYNC_ENABLED=true
SOCIAL_INVITE_URL=https://ziipa.com

# Testnet-only Web3. Local mode must remain false in hosted deployments.
WEB3_ENABLE_LOCAL=false
WEB3_PUBLIC_ORIGIN=http://localhost:8082
WEB3_BASE_RPC=https://sepolia.base.org
WEB3_SEPOLIA_RPC=https://ethereum-sepolia-rpc.publicnode.com
WEB3_LOCAL_RPC=http://127.0.0.1:8545
# WEB3_REGISTRY=/absolute/path/to/reviewed-web3-deployments.json
# WEB3_REGISTRY_JSON={"84532":{"collectibles":{"address":"0x...","code_hash":"0x..."},"factory":{"address":"0x...","code_hash":"0x..."},"tips":{"address":"0x...","code_hash":"0x..."}}}
IPFS_API_URL=http://127.0.0.1:56001
IPFS_PUBLIC=false
PINATA_JWT=

# Public broadcasting. Leave blank until a reviewed Livepeer Studio account exists.
LIVEPEER_API_KEY=
LIVE_MAX_STREAMS_PER_OWNER=3
LIVE_DAILY_CREATE_LIMIT=10

# Direct social publishing. Secrets stay on the API server only.
# Generate a 32-byte random key and base64-encode it; preserve it in your secret manager.
PUBLISHING_ENCRYPTION_KEY=
# OAuth must start and return on the SAME website cookie origin, through /api proxy.
PUBLISHING_API_ORIGIN=https://ziipa.com
PUBLISHING_APPROVED_ORIGINS=https://ziipa.com
PUBLISHING_PORTAL_URL=https://ziipa.com/portal
PUBLISHING_ALLOW_INSECURE_LOCALHOST=false
PUBLISHING_YOUTUBE_CLIENT_ID=
PUBLISHING_YOUTUBE_CLIENT_SECRET=
PUBLISHING_YOUTUBE_PUBLIC_APPROVED=false
PUBLISHING_TIKTOK_CLIENT_KEY=
PUBLISHING_TIKTOK_CLIENT_SECRET=
PUBLISHING_TIKTOK_PUBLIC_APPROVED=false
# Empty until the API domain is verified in TikTok Manage URL properties.
# Then set the exact HTTPS PUBLISHING_API_ORIGIN (for example https://ziipa.com).
PUBLISHING_TIKTOK_VERIFIED_MEDIA_ORIGINS=
PUBLISHING_META_CLIENT_ID=
PUBLISHING_META_CLIENT_SECRET=
PUBLISHING_META_GRAPH_VERSION=
# Exact HTTPS storage origins from which Instagram may fetch an owned signed video.
PUBLISHING_META_MEDIA_ORIGINS=
PUBLISHING_META_PUBLIC_APPROVED=false
PUBLISHING_TWITCH_CLIENT_ID=
PUBLISHING_TWITCH_CLIENT_SECRET=
# Official AT Protocol OAuth SDK bridge: Node >=22 and npm ci in atproto_bridge.
# Stable private P-256 JWK JSON with kty, crv, kid, x, y, d; never send to clients.
PUBLISHING_BLUESKY_ENABLED=false
PUBLISHING_BLUESKY_PRIVATE_JWK=
PUBLISHING_BLUESKY_NODE_BINARY=node
# Optional operator-reviewed exact HTTPS origins for additional PDS/auth servers.
# Public IP/DNS, issuer, DID and scoped-token checks still apply.
PUBLISHING_BLUESKY_EXTRA_ORIGINS=

# Same randomly generated >=32-character secret on the website Worker and API.
# Authenticates the edge-provided visitor IP for per-visitor rate limits.
# Leave blank for direct local access; never expose as VITE_ or EXPO_PUBLIC_.
ZIIPA_PROXY_SECRET=

# A separate CPU worker uses the same DB, Redis and media storage as the API.
# Do not put rendering into the HTTP request handler or auto-start it in replicas.
RENDER_ENABLED=false
RENDER_FFMPEG=ffmpeg
RENDER_FFPROBE=ffprobe
RENDER_FONT=/usr/share/fonts/truetype/dejavu/DejaVuSans.ttf
RENDER_WORK_DIR=.render-work
RENDER_TIMEOUT_SECONDS=180
RENDER_POLL_SECONDS=30
# Durable DB recovery scan for a lost Redis enqueue hint or interrupted worker.
RENDER_RECONCILE_SECONDS=1800
