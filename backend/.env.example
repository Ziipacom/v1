DATABASE_URL=postgresql+psycopg://ziipa:ziipa_local@127.0.0.1:55439/ziipa
REDIS_URL=redis://127.0.0.1:56389/0
FRONTEND_ORIGIN=http://localhost:5178
MOBILE_WEB_ORIGIN=http://localhost:8082
UPLOADS_DIR=uploads
SECURE_COOKIES=false
MODERATOR_EMAILS=
ENABLE_DEMO_CATALOG=true
ENVIRONMENT=development
RELEASE=local
API_PUBLIC_ORIGIN=http://localhost:8018
PUBLIC_APP_URL=http://localhost:5178

# Production account email. Registration remains usable in local demo mode when unset.
REQUIRE_EMAIL_VERIFICATION=false
RESEND_API_KEY=
EMAIL_FROM=Ziipa <accounts@ziipa.com>
SENTRY_DSN=

# Private creator media. Use local in development and r2 in hosted environments.
MEDIA_STORAGE_BACKEND=local
R2_ENDPOINT_URL=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=ziipa-media
R2_PRESIGN_TTL_SECONDS=900
R2_DOWNLOAD_TTL_SECONDS=300

# Public client identifiers only. Provider secrets belong in a secret manager.
# Account OAuth callbacks and provider review are required before direct posting.
SOCIAL_BLUESKY_CLIENT_ID=
SOCIAL_FACEBOOK_CLIENT_ID=
SOCIAL_INSTAGRAM_CLIENT_ID=
SOCIAL_TIKTOK_CLIENT_ID=
SOCIAL_TWITCH_CLIENT_ID=
SOCIAL_YOUTUBE_CLIENT_ID=

# Testnet-only Web3. Local mode must remain false in hosted deployments.
WEB3_ENABLE_LOCAL=false
WEB3_PUBLIC_ORIGIN=http://localhost:8082
WEB3_BASE_RPC=https://sepolia.base.org
WEB3_SEPOLIA_RPC=https://ethereum-sepolia-rpc.publicnode.com
WEB3_LOCAL_RPC=http://127.0.0.1:8545
# WEB3_REGISTRY=/absolute/path/to/reviewed-web3-deployments.json
# WEB3_REGISTRY_JSON={"84532":{"collectibles":{"address":"0x...","code_hash":"0x..."},"factory":{"address":"0x...","code_hash":"0x..."},"tips":{"address":"0x...","code_hash":"0x..."}}}
IPFS_API_URL=http://127.0.0.1:56001
IPFS_PUBLIC=false
PINATA_JWT=
