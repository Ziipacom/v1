[Unit]
Description=Ziipa limited private calendar and Web Push scheduler (free Micro)
Requires=docker.service
After=docker.service network-online.target
Wants=network-online.target
StartLimitIntervalSec=900
StartLimitBurst=3

[Service]
Type=simple
WorkingDirectory=/opt/ziipa/deploy/oracle-free
UMask=0077
ExecStartPre=/usr/bin/python3 /opt/ziipa/deploy/oracle-free/scheduler-preflight.py
ExecStart=/usr/bin/flock --nonblock /run/ziipa-scheduler-worker.lock /usr/bin/docker compose --ansi never -f scheduler-compose.json up --no-build --pull never --abort-on-container-exit --exit-code-from scheduler-worker
ExecStop=/usr/bin/docker compose --ansi never -f scheduler-compose.json stop --timeout 90 scheduler-worker
TimeoutStopSec=120
Restart=always
RestartSec=60

[Install]
WantedBy=multi-user.target
