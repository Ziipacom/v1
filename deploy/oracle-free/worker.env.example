# Copy outside the checkout to /etc/ziipa/render-worker.env, root:root mode 0600.
# Exact existing API settings only. This intentionally contains no credentials.
# One literal KEY=value per line; do not quote values or add inline comments.
# Compose 2.30+ raw format preserves $ and # in passwords. URL-encode URL passwords.
# DATABASE_URL must include ?sslmode=require (or verify-ca / verify-full).
DATABASE_URL=
# REDIS_URL must begin rediss:// and match the existing API's database index.
REDIS_URL=
# Private existing bucket; no public bucket or separate worker storage.
R2_ENDPOINT_URL=
R2_BUCKET_NAME=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
# Match the API. Positive limits only; this package rejects exceeding 1/6 GiB.
MEDIA_OWNER_MAX_BYTES=1073741824
MEDIA_PROJECT_MAX_BYTES=6442450944
