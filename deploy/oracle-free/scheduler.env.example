# NEW limited Micro destination. Never reuse render-worker.env/workflow-worker.env.
# Install only after owner authorization, as root:root 0600 under /etc/ziipa.
DATABASE_URL=postgresql+psycopg://REPLACE:REPLACE@REPLACE/ziipa?sslmode=require
REDIS_URL=rediss://default:REPLACE@REPLACE:6379/0
PUSH_ENABLED=false
# Dedicated Web Push keys only after approved transfer and actual device opt-in.
PUSH_ENCRYPTION_KEY=
PUSH_VAPID_PRIVATE_KEY=
PUSH_VAPID_PUBLIC_KEY=
PUSH_VAPID_SUBJECT=
# Optional native HTTP delivery only after verified owner EAS/FCM/APNs setup,
# replacement binary, device opt-in and separately approved credential transfer.
# Existing Web-only files may omit these two settings; defaults remain disabled.
PUSH_EXPO_ENABLED=false
PUSH_EXPO_ACCESS_TOKEN=
# Livepeer, R2, webhook, social, email, wallet and AI secrets are forbidden.
