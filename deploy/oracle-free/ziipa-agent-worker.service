[Unit]
Description=Ziipa bounded private-workspace autonomous agent
Requires=docker.service
After=docker.service network-online.target ziipa-inference.service ziipa-inference-tunnel.service ziipa-inference-small.service ziipa-inference-small-tunnel.service
Conflicts=ziipa-agent-worker-small.service
Wants=network-online.target
StartLimitIntervalSec=900
StartLimitBurst=3

[Service]
Type=simple
WorkingDirectory=/opt/ziipa/deploy/oracle-free
UMask=0077
ExecStartPre=/usr/bin/python3 /opt/ziipa/deploy/oracle-free/preflight.py
ExecStartPre=/usr/bin/python3 /opt/ziipa/deploy/oracle-free/agent_preflight.py
ExecStart=/usr/bin/docker compose --ansi never -f agent-compose.json up --no-build --pull never --abort-on-container-exit --exit-code-from agent-worker
ExecStop=/usr/bin/docker compose --ansi never -f agent-compose.json stop --timeout 60 agent-worker
TimeoutStopSec=90
Restart=always
RestartSec=60

[Install]
WantedBy=multi-user.target
