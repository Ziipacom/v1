{
  "name": "ziipa-oracle-agent",
  "services": {
    "agent-worker": {
      "image": "ziipa-render:oracle-arm64",
      "platform": "linux/arm64",
      "pull_policy": "never",
      "command": ["python", "agent_worker.py"],
      "env_file": [
        {"path": "/etc/ziipa/render-worker.env", "required": true, "format": "raw"},
        {"path": "/etc/ziipa/agent-inference.env", "required": true, "format": "raw"}
      ],
      "environment": {
        "ENVIRONMENT": "production", "SECURE_COOKIES": "true",
        "ENABLE_DEMO_CATALOG": "false", "WEB3_ENABLE_LOCAL": "false",
        "MEDIA_STORAGE_BACKEND": "r2", "RENDER_ENABLED": "true",
        "OS_AGENT_ENABLED": "true", "OS_AGENT_POLL_SECONDS": "60",
        "OS_AGENT_RECONCILE_SECONDS": "3600",
        "OS_ASSISTANT_LOCAL_AI_ENABLED": "true",
        "OS_ASSISTANT_INFERENCE_URL": "http://127.0.0.1:8089"
      },
      "network_mode": "host",
      "user": "10001:10001", "init": true, "read_only": true,
      "cap_drop": ["ALL"], "security_opt": ["no-new-privileges:true"],
      "cpus": "0.10", "mem_limit": "256m", "memswap_limit": "256m", "pids_limit": 64,
      "tmpfs": ["/tmp:rw,noexec,nosuid,nodev,size=16777216,mode=1777"],
      "shm_size": "8m", "ulimits": {"core": 0, "nofile": {"soft": 256, "hard": 256}},
      "stop_grace_period": "60s", "restart": "no",
      "logging": {"driver": "local", "options": {"max-size": "5m", "max-file": "2"}}
    }
  }
}
