{
  "services": {
    "ollama": {
      "environment": { "OLLAMA_CONTEXT_LENGTH": "4096" },
      "cpus": "0.60", "mem_limit": "1024m", "memswap_limit": "1024m", "pids_limit": 96
    },
    "inference-gateway": {
      "mem_limit": "128m", "memswap_limit": "128m",
      "environment": {
        "ZIIPA_INFERENCE_MODEL": "qwen3:0.6b", "ZIIPA_INFERENCE_CONTEXT_TOKENS": "4096",
        "ZIIPA_INFERENCE_OUTPUT_TOKENS": "450", "ZIIPA_INFERENCE_REQUESTS_PER_MINUTE": "6"
      }
    }
  }
}
