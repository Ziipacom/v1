# Optional workflow-only settings. Never append these to render-worker.env.
# Copy only when absent to /etc/ziipa/workflow-worker.env, root:root mode 0600.
# Literal KEY=value; no quotes, inline comments or shell sourcing. No secrets here.
# Keep new features false until matching API/schema/native-worker acceptance.
# The existing workflow loop remains enabled by Compose even without this file.
OS_CALENDAR_ENABLED=false
CREATION_CAMPAIGN_ENABLED=false
LIVE_RECORDINGS_ENABLED=false
PUSH_ENABLED=false
# Retain the existing reviewed public-profile sync behavior (no private feeds).
SOCIAL_PUBLIC_SYNC_ENABLED=true
# Existing approved server key only; enabling imports needs separate authorization.
# LIVE_WEBHOOK_ID/SECRET belong on the API, never in this worker file.
LIVEPEER_API_KEY=
# Optional Web Push only: same dedicated keys/contact as the API.
# Encryption: 32-byte base64url. VAPID: P256 PKCS8 DER and public65-byte point.
PUSH_ENCRYPTION_KEY=
PUSH_VAPID_PRIVATE_KEY=
PUSH_VAPID_PUBLIC_KEY=
PUSH_VAPID_SUBJECT=https://ziipa.com
