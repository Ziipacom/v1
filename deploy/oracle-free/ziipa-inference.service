[Unit]
Description=Ziipa private local-model inference (Oracle Always Free)
Requires=docker.service
After=docker.service network-online.target
Wants=network-online.target
Conflicts=ziipa-inference-tunnel.service ziipa-inference-small.service ziipa-inference-small-tunnel.service
StartLimitIntervalSec=900
StartLimitBurst=3

[Service]
Type=simple
WorkingDirectory=/opt/ziipa/deploy/oracle-free
UMask=0077
ExecStartPre=/usr/bin/python3 /opt/ziipa/deploy/oracle-free/inference_preflight.py
ExecStart=/usr/bin/docker compose --ansi never -f inference-compose.json up --no-build --pull never --abort-on-container-exit
ExecStop=/usr/bin/docker compose --ansi never -f inference-compose.json stop --timeout 60
TimeoutStopSec=90
Restart=always
RestartSec=60

[Install]
WantedBy=multi-user.target
