{
  "name": "ziipa-oracle-inference",
  "services": {
    "ollama": {
      "image": "ziipa-ollama:oracle-arm64",
      "platform": "linux/arm64",
      "pull_policy": "never",
      "command": ["serve"],
      "environment": {
        "OLLAMA_HOST": "0.0.0.0:11434", "OLLAMA_MODELS": "/models",
        "OLLAMA_NO_CLOUD": "1", "OLLAMA_NUM_PARALLEL": "1",
        "OLLAMA_MAX_LOADED_MODELS": "1", "OLLAMA_MAX_QUEUE": "1",
        "OLLAMA_CONTEXT_LENGTH": "6144", "OLLAMA_KEEP_ALIVE": "3m",
        "OLLAMA_DEBUG": "false", "OLLAMA_ORIGINS": "http://inference-gateway:8089"
      },
      "user": "10001:10001", "init": true, "read_only": true,
      "cap_drop": ["ALL"], "security_opt": ["no-new-privileges:true"],
      "cpus": "0.75", "mem_limit": "2g", "memswap_limit": "2g", "pids_limit": 128,
      "tmpfs": ["/tmp:rw,noexec,nosuid,nodev,size=67108864,mode=1777", "/home/ollama:rw,noexec,nosuid,nodev,size=1048576,uid=10001,gid=10001,mode=0700"],
      "volumes": ["ollama_models:/models:ro"], "networks": ["model-private"],
      "healthcheck": { "test": ["CMD", "ollama", "list"], "interval": "30s", "timeout": "5s", "retries": 3 },
      "restart": "no", "stop_grace_period": "30s",
      "logging": { "driver": "local", "options": { "max-size": "5m", "max-file": "2" } }
    },
    "inference-gateway": {
      "image": "ziipa-inference:oracle-arm64", "platform": "linux/arm64", "pull_policy": "never",
      "env_file": [{ "path": "/etc/ziipa/inference-gateway.env", "required": true, "format": "raw" }],
      "environment": { "ZIIPA_INFERENCE_OLLAMA_URL": "http://ollama:11434", "ZIIPA_INFERENCE_TIMEOUT_SECONDS": "45", "ZIIPA_INFERENCE_REQUESTS_PER_MINUTE": "12" },
      "ports": ["127.0.0.1:8089:8089"],
      "depends_on": { "ollama": { "condition": "service_healthy" } },
      "user": "10001:10001", "init": true, "read_only": true,
      "cap_drop": ["ALL"], "security_opt": ["no-new-privileges:true"],
      "cpus": "0.10", "mem_limit": "192m", "memswap_limit": "192m", "pids_limit": 64,
      "tmpfs": ["/tmp:rw,noexec,nosuid,nodev,size=16777216,mode=1777"],
      "networks": ["model-private", "gateway-egress"],
      "healthcheck": { "test": ["CMD", "python", "-c", "import urllib.request; urllib.request.urlopen('http://127.0.0.1:8089/livez', timeout=3).read()"], "interval": "30s", "timeout": "5s", "retries": 3 },
      "restart": "no", "stop_grace_period": "60s",
      "logging": { "driver": "local", "options": { "max-size": "5m", "max-file": "2" } }
    }
  },
  "networks": { "model-private": { "internal": true }, "gateway-egress": {} },
  "volumes": { "ollama_models": { "name": "ziipa-inference-models" } }
}
